{
  "schemaVersion": 1,
  "skill": "daily-hotspots",
  "tasks": [
    {
      "id": "daily-hotspots/dailyhotspots",
      "name": "DailyHotspots",
      "purpose": "Daily frontier business-opportunity radar: collect, score, dedup and deliver one digest.",
      "enabled": true,
      "trigger": {"type": "daily", "at": "08:07"},
      "argv": [
        "%SystemRoot%\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
        "-WindowStyle", "Hidden", "-ExecutionPolicy", "Bypass", "-NoProfile",
        "-File", "${SKILL_ROOT}/skills/daily-hotspots/scripts/wrapper.ps1",
        "-Python", "%ProgramData%\\miniconda3\\python.exe",
        "-ConfigDir", "${COMPANION_ROOT}"
      ],
      "cwd": "${SKILL_ROOT}",
      "timeout_seconds": 7200,
      "checks": [
        {"id": "digest", "required": true,
         "health": {"label": "daily-hotspots digest (daily 08:07)", "max_age_hours": 30,
                    "artifact": "${COMPANION_ROOT}/archive/digests", "artifact_max_age_hours": 30}}
      ]
    },
    {
      "id": "daily-hotspots/dailyhotspotsyield",
      "name": "DailyHotspotsYield",
      "purpose": "Weekly report-only signal-yield replay that writes the roster review queue.",
      "enabled": true,
      "trigger": {"type": "weekly", "at": "08:37", "days": ["mon"]},
      "argv": [
        "%SystemRoot%\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
        "-ExecutionPolicy", "Bypass", "-NoProfile",
        "-File", "${SKILL_ROOT}/skills/daily-hotspots/scripts/yield-wrapper.ps1",
        "-Python", "%ProgramData%\\miniconda3\\python.exe",
        "-ConfigDir", "${COMPANION_ROOT}",
        "-ReportOnly"
      ],
      "cwd": "${SKILL_ROOT}",
      "timeout_seconds": 1200,
      "checks": [
        {"id": "review", "required": true,
         "health": {"label": "daily-hotspots drift/yield (weekly)", "max_age_hours": 200,
                    "artifact": "${COMPANION_ROOT}/archive/roster-review.md", "artifact_max_age_hours": 820}}
      ]
    },
    {
      "id": "daily-hotspots/dailyhotspotsidentitysweep",
      "name": "DailyHotspotsIdentitySweep",
      "purpose": "Monthly report-only get_user_info sweep that flags renamed and dead roster handles.",
      "enabled": true,
      "trigger": {"type": "monthly", "at": "11:00", "days": [1]},
      "argv": [
        "%LOCALAPPDATA%\\Programs\\credvault\\credvault-cli.exe",
        "exec", "--map", "${COMPANION_ROOT}/automation/vault.map.json", "--",
        "%SystemRoot%\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
        "-ExecutionPolicy", "Bypass", "-NoProfile",
        "-File", "${SKILL_ROOT}/skills/daily-hotspots/scripts/identity-sweep-wrapper.ps1",
        "-Python", "%ProgramData%\\miniconda3\\python.exe",
        "-ConfigDir", "${COMPANION_ROOT}"
      ],
      "cwd": "${SKILL_ROOT}",
      "timeout_seconds": 1800,
      "checks": [
        {"id": "sweep", "required": true,
         "health": {"label": "daily-hotspots identity sweep (monthly)", "max_age_hours": 820}}
      ]
    },
    {
      "id": "daily-hotspots/dailyhotspotscompleteness",
      "name": "DailyHotspotsCompleteness",
      "purpose": "Opt-in daily archive completeness scan that names every missing digest date.",
      "enabled": false,
      "trigger": {"type": "daily", "at": "09:11"},
      "argv": [
        "%SystemRoot%\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
        "-ExecutionPolicy", "Bypass", "-NoProfile",
        "-File", "${SKILL_ROOT}/skills/daily-hotspots/scripts/wrapper.ps1",
        "-Python", "%ProgramData%\\miniconda3\\python.exe",
        "-ConfigDir", "${COMPANION_ROOT}",
        "-CompletenessOnly"
      ],
      "cwd": "${SKILL_ROOT}",
      "timeout_seconds": 1200,
      "checks": [
        {"id": "scan", "required": false,
         "health": {"label": "daily-hotspots completeness scan (daily 09:11)", "max_age_hours": 30,
                    "artifact": "${COMPANION_ROOT}/archive/completeness.json", "artifact_max_age_hours": 30}}
      ]
    }
  ]
}
